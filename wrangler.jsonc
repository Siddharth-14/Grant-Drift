{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker name in the Cloudflare dashboard, or Workers Builds refuses to deploy.
  "name": "grant-drift-cloudflare",
  "compatibility_date": "2026-10-01",
  // Static site: no Worker script, just the Vite build output.
  "assets": { "directory": "./dist" },
  // Build here too, so a dashboard with an empty build command still deploys a real site.
  "build": { "command": "npm ci && npm run build" }
}
